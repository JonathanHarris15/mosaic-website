# The design-token files are generated with LF and uploaded verbatim to the
# Mosaic Website Design system. Pin them so a Windows checkout does not hand
# the design system CRLF that nothing on this side wrote.
build/design-tokens/*.css       text eol=lf
scripts/build-design-tokens.mjs text eol=lf

# Golden files are compared byte for byte against freshly rendered output,
# and the renderers emit LF. Git stores these with LF, but core.autocrlf=true
# rewrites them to CRLF on checkout — so on Windows the comparison failed on
# every line ending and the test could never pass. Pin them.
test/fixtures/**                text eol=lf
