rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Effective permission level for the signed-in user. Reads the new
    // `permissionLevel` field, falling back to the legacy `role` field during the
    // MS-119 migration while both coexist (MS-127 drops `role` afterwards).
    // Callers guard on request.auth first, so this get() only runs when signed in.
    function permissionLevel() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('permissionLevel' in d) ? d.permissionLevel : d.role;
    }

    // Somebody holding an account, which is NOT the same as `request.auth !=
    // null` — and on this project the difference is the whole boundary.
    //
    // ⚠ ANONYMOUS SIGN-IN IS ENABLED HERE. The API key ships in the browser
    // because that is what an API key is for, and one POST to the Identity
    // Toolkit with nothing but that key returns a valid token. No email, no
    // password, no sign-up form, no trace anybody would recognise as a person.
    // `request.auth != null` accepts that token, so a rule written that way is
    // open to the internet with an extra HTTP request in front of it — which
    // is exactly how MS-197 shipped the first time.
    //
    // Nothing in this app ever calls signInAnonymously. Every client already
    // treats an anonymous session as signed out (auth.js, login.html, main.js,
    // profile.js, mobile/data.js all test `!user.isAnonymous`), so this is the
    // rules file catching up with what the app has always believed.
    //
    // Belt and braces: anonymous sign-in should also be turned OFF in the
    // Firebase console, since nothing uses it. This rule holds either way, and
    // a console toggle somebody can flip back is not where a boundary belongs.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && permissionLevel() in ['admin', 'super_admin'];
    }

    // Helper to check if user is editor
    function isEditor() {
      return request.auth != null && permissionLevel() in ['editor', 'admin', 'elder', 'super_admin'];
    }

    // Helper to check if user is a member or above. The floor of the `member`
    // visibility rung (MS-99): a viewer is signed in but sees only public things.
    function isMember() {
      return request.auth != null
        && permissionLevel() in ['member', 'editor', 'admin', 'elder', 'super_admin'];
    }

    // The Person record this signed-in User is linked to, or null. Event
    // `participant` visibility is answered against Person ids, not User ids.
    function myPersonId() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('personId' in d) ? d.personId : null;
    }

    // Helper to check if user is elder or super_admin
    function isElder() {
      return request.auth != null && permissionLevel() in ['elder', 'super_admin'];
    }

    // A Kiosk is its own permissionLevel, not a rung on the ladder (MS-318,
    // ADR-0041). Parallel to isElder()/isAdmin(): an allowlist of one value.
    function isKiosk() {
      return request.auth != null && permissionLevel() == 'kiosk';
    }

    // ⚠ NO USER DOCUMENT MAY CARRY A PASSWORD (MS-241, ADR-0040).
    //
    // Sign-up used to write the password here in plain text, and three other
    // paths copied that line. Firebase Authentication holds the hashed copy and
    // is the only party that should ever hold one; a readable second copy is a
    // list of this congregation's passwords, which is a list of their email
    // accounts and their banking.
    //
    // The code no longer writes it, but code is deployed and browsers are cached.
    // This is what stops a stale tab, or the next person to copy the old sign-up
    // block, putting it back. Cloud Functions use the Admin SDK and bypass rules
    // entirely, so the legitimate admin.auth() calls are unaffected.
    function noStoredPassword() {
      return !('password' in request.resource.data);
    }

    match /users/{userId} {
      // Allow users to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow users to create their own document as 'viewer' (permission level).
      // During the MS-119 migration the client writes both permissionLevel and the
      // legacy role; accept whichever the new doc carries.
      allow create: if request.auth != null && request.auth.uid == userId
        && noStoredPassword()
        && (('permissionLevel' in request.resource.data)
            ? request.resource.data.permissionLevel == 'viewer'
            : request.resource.data.role == 'viewer');
      // Allow users to update ONLY their own dashboard card arrangement.
      // Restricting the affected keys prevents self role-escalation or tampering
      // with any other field (email, personId, etc.).
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dashboardCardOrder']);
      // Admins read and write any user document — but the password bar binds
      // them too. It is split off `write` deliberately: `allow read, write` would
      // grant a create carrying a password and undo the rule above, since one
      // allow statement granting a request is enough. Delete is separate because
      // a delete has no request.resource to inspect.
      allow read: if isAdmin();
      allow create, update: if isAdmin() && noStoredPassword();
      allow delete: if isAdmin();
    }

    // Directory Requests (ADR-0025, ADR-0027): anything a person asks the church
    // to change about their own directory record — connect me to a record, add
    // me to the directory, fix my name's spelling, record my household.
    //
    // Document ids are namespaced `${uid}_...`, and this rule REQUIRES it. That
    // is what keeps one person's requests out of everyone else's namespace
    // without the rules having to trust a field, and it is why a second ask of
    // the same kind overwrites the first instead of piling up.
    //
    // Note what is missing: there is no `allow update`. Resolving a request
    // writes users/{uid}.personId, people/{id}.name, or the families
    // collection — on behalf of someone who may be a plain member. A rule wide
    // enough to let an editor approve here would be a rule wide enough to let
    // them change permission levels. So approval goes through the
    // resolveDirectoryRequest callable, which runs with admin privileges and
    // bypasses these rules entirely. No browser ever updates a request.
    match /directory_requests/{requestId} {
      // The requester sees their own; editors, elders and admins see the queue.
      allow read: if request.auth != null
        && (requestId.matches(request.auth.uid + '_.*') || isEditor());

      // You may only ask on your own behalf, only as pending, and only in your
      // own id namespace. A link request additionally requires that you are not
      // already linked — an existing link is the thing it is for.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && requestId.matches(request.auth.uid + '_.*')
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['link_match', 'link_new', 'name_fix', 'family']
        && (
          !(request.resource.data.kind in ['link_match', 'link_new'])
          || myPersonId() == null
        )
        // A name fix or a family change is only ever about your OWN Person.
        && (
          !(request.resource.data.kind in ['name_fix', 'family'])
          || request.resource.data.personId == myPersonId()
        );

      // Withdraw your own request (and so file a fresh one after a decline);
      // approvers may clear resolved requests out of the queue. Deleting a
      // request never touches what it asked for.
      allow delete: if request.auth != null
        && (requestId.matches(request.auth.uid + '_.*') || isEditor());
    }

    match /hymns/{hymnId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    
    match /tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // Servant Role Definitions (ADR-0016, MS-13): name, ordered slots, and
    // restriction rules read against existing Tags and Relationships. Authored
    // in the Roles Manager by editors; read like the other config collections so
    // any surface showing who is serving can name the Role. Liturgical Roles are
    // NOT here — they are code-defined and locked, so there is nothing to store.
    match /roles/{roleId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // ── Events, occurrences, and the five-rung visibility ladder ────────────
    //
    // ADR-0018 §5. Visibility is `public` → `member` → `participant` → `editor`
    // → `elder`, and it is STAMPED ONTO EVERY OCCURRENCE rather than looked up
    // from the series. A rule cannot afford a get() per row without hitting the
    // rules engine's lookup limits on any real list query — the lesson already
    // learned in MS-130 for the relationship collections.
    //
    // FAILS CLOSED. Every clause tests the stamped value for equality against a
    // named rung, so a document with no `visibility` field matches nothing and is
    // readable by nobody. That is deliberate: the failure mode being guarded
    // against is an occurrence quietly shipping unstamped and going public.
    //
    // ⚠ QUERY CONSTRAINT — read this before debugging an "empty" calendar.
    // Firestore evaluates these rules PER RETURNED DOCUMENT and fails the WHOLE
    // query if any document would fail. The Calendar MUST therefore constrain its
    // own reads — one query filtered by the viewer's rank, one `array-contains`
    // their Person id, merged client-side, because Firestore cannot express that
    // as a single filter:
    //     .where('visibility', 'in', rungsForMyRank)
    //     .where('participantIds', 'array-contains', myPersonId)
    // An unconstrained query does not return fewer rows — it errors outright, and
    // the error looks exactly like "this church has no events".
    // EventsOccurrenceCore.visibilityQueryFor() is the one place that builds them.

    // The stamped rung, or 'none' when the field is absent. 'none' is not a rung,
    // so an unstamped document is readable by nobody.
    function stampedVisibility() {
      return ('visibility' in resource.data) ? resource.data.visibility : 'none';
    }

    // Rank alone. `participant` is NOT here for a member — it cannot be answered
    // by rank, which is the whole reason the Calendar runs a second query — but
    // everyone above participant sees participant-level Events without holding a
    // Role on them.
    function rankCanSee(visibility) {
      return visibility == 'public'
        || (isMember() && visibility == 'member')
        || (isEditor() && visibility in ['member', 'participant', 'editor'])
        || (isElder() && visibility == 'elder');
    }

    // The one rung rank cannot answer, checked against the occurrence's own
    // denormalised participant list. Someone who DECLINED is still in that list —
    // they keep their place, and their sight of the Event, until somebody else
    // takes the slot. Someone removed by an editor leaves the list in the same
    // write, and loses sight of it instantly.
    function isEventParticipant() {
      return request.auth != null
        && ('participantIds' in resource.data)
        && myPersonId() in resource.data.participantIds;
    }

    // Event series (ADR-0016, MS-13; visibility added by ADR-0018): the recurring
    // things that carry Roles.
    //
    // NO LONGER WORLD-READABLE. Harmless while the only series was the Sunday
    // Service; the moment "Elders' Meeting" can be a series, its name would be
    // public to the internet.
    //
    // The Sunday Service is permanently public and is named here rather than
    // relying on a stamp, so the Services page and the congregant-facing Service
    // Guide keep working exactly as they do today, with no migration in between.
    //
    // A series carries no participant list — participation is per occurrence — so
    // `participant`-level series are reachable by editors and above only. A
    // participant does not need the series: an Event they hold a Role on always
    // HAS an occurrence document (that is where their assignment lives), and the
    // occurrence carries everything the Calendar renders.
    match /events/{eventId} {
      allow read: if isKiosk()
        || eventId == 'sunday_service'
        || rankCanSee(stampedVisibility());
      allow create, update, delete: if isEditor();
    }

    // Event occurrences (ADR-0018 §3): the dated instances. SPARSE — a document
    // exists only once something lands on the date, so an untouched date still
    // appears in the Calendar, computed from the series' recurrence rule.
    match /event_occurrences/{occurrenceId} {
      allow read: if isKiosk()
        || rankCanSee(stampedVisibility())
        || (stampedVisibility() == 'participant' && isEventParticipant());
      allow create, update, delete: if isEditor();

      // Attendance (MS-318, ADR-0042): who was physically here. Written live
      // by a Kiosk; document id is the Person id, so a second mark overwrites.
      // Readable by the same floors that can already read the roster, plus the
      // Kiosk that writes it.
      match /attendance/{personId} {
        allow read: if isKiosk()
          || isEditor()
          || (request.auth != null && personId == myPersonId())
          || (request.auth != null
              && get(/databases/$(database)/documents/event_occurrences/$(occurrenceId)).data.rosterShared == true
              && myPersonId() in get(/databases/$(database)/documents/event_occurrences/$(occurrenceId)).data.participantIds);
        allow create, update: if isKiosk();
        allow delete: if isKiosk() || isEditor();
      }

      // The roster — who else is serving. Firestore cannot hide a FIELD from
      // someone allowed to read a document, so "participants can't see who else
      // is coming" only works if the roster is stored separately (ADR-0018 §5).
      //
      // Your OWN assignment is always readable — you are always allowed to know
      // what you have been asked to do. Everyone else's depends on the Event's
      // roster setting, which is the editor's choice per Event.
      match /roster/{assignmentId} {
        allow read: if isEditor()
          || (request.auth != null && resource.data.personId == myPersonId())
          || (request.auth != null
              && get(/databases/$(database)/documents/event_occurrences/$(occurrenceId)).data.rosterShared == true
              && myPersonId() in get(/databases/$(database)/documents/event_occurrences/$(occurrenceId)).data.participantIds);
        allow create, update, delete: if isEditor();
      }
    }

    // The Calendar needs YOUR OWN assignments across a whole month without
    // reading anybody else's, so it queries each Event's roster for your Person
    // id. Your own row is always readable — you are always allowed to know what
    // you have been asked to do — and everyone else's still depends on the
    // Event's roster setting via the rule above.
    //
    // ⚠ Constrain this query. `.where('personId', '==', myPersonId)` is what
    // makes it legal; unconstrained it returns other people's rows, they fail,
    // and the whole read errors.
    match /{path=**}/roster/{assignmentId} {
      allow read: if isEditor()
        || (request.auth != null && resource.data.personId == myPersonId());
    }

    // The cover list (MS-20, ADR-0030): every Assignment currently needing
    // somebody, so a member can pick one up without an editor brokering it.
    //
    // ⚠ A SEPARATE COLLECTION, NOT A QUERY OVER DECLINED ROSTER ROWS. The
    // roster subcollection above exists precisely so a member cannot read
    // anybody else's Assignment, and its collection-group rule is clamped to
    // your own personId. Building the list from those rows would mean opening
    // every roster row to every member — removing that gate rather than bending
    // it. So a small document is written beside the decline instead, carrying
    // only what a row needs to render and be taken.
    //
    // Each entry is STAMPED with its occurrence's visibility at write time, so
    // this rule answers by rank with no get() per document — the same reason
    // occurrences carry their own stamp (ADR-0018 §5, following MS-130).
    //
    // No `participant` clause, deliberately. An Event at that rung never reaches
    // this list: the list exists to reach people who are NOT in the Event, and
    // there is nobody it could reach there without disclosing what the rung is
    // for. An entry stamped `participant` would be a bug, and rankCanSee refuses
    // it for a member anyway.
    //
    // NOBODY WRITES THIS FROM A BROWSER. Entries are created and removed only by
    // the callable that handles the decline or the hand-over, inside the same
    // transaction as the roster change, so the list cannot drift from the
    // rosters it describes. The Admin SDK bypasses these rules; every client is
    // refused, editors included.
    match /cover/{coverId} {
      allow read: if rankCanSee(stampedVisibility());
      allow create, update, delete: if false;
    }

    // Trades (MS-190). A Trade names two people and what each is giving up.
    //
    // ⚠ READ BY THE TWO PARTIES AND NOBODY ELSE — not an editor, not an elder.
    // That is deliberately a DIFFERENT rule from the cover list above, which is
    // stamped with a rung and readable by anybody at it. The cover list is an
    // advertisement; a Trade is a conversation, and there is no rank at which
    // reading somebody else's becomes anybody's business.
    //
    // ⚠ NO CLIENT WRITES AT ALL. Every transition goes through a callable, so
    // the state machine cannot be walked round with a browser console. An
    // editor's clause here would be the same hole with a nicer name: they have
    // direct assignment already, which ends every Trade on the slot anyway.
    match /trades/{tradeId} {
      allow read: if isMember()
                  && (resource.data.holderId == myPersonId()
                      || resource.data.counterpartyId == myPersonId());
      allow create, update, delete: if false;
    }

    match /services/{dateId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // How many times each scripture reference has been used in an Order of
    // Service, and when last — maintained by updateOrderOfServiceUsageStats
    // (functions/index.js) reacting to services/{date} writes. Same
    // server-write-only shape as cover/trades above: a client recomputing
    // its own count from a partial view of history would drift from the
    // real one, so there is no client write path at all.
    match /scripture_usage/{referenceId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Every distinct Service Theme, its embedding vector, and the dates it
    // was used (docs/plans/theme-similarity.md) — maintained by
    // onServiceThemeWritten reacting to services/{date} writes. Member+ read
    // (same rung as the rest of the service data); no client write path —
    // embedding is a paid API call and vectors from a client-chosen model
    // would silently break comparability with the rest of the corpus.
    match /themes/{themeKey} {
      allow read: if isMember();
      allow create, update, delete: if false;
    }

    // Service Guide Template System (ADR-0008). The Page Library, Style Presets,
    // and Service Guide Templates are global, editor-authored content — public
    // read (the booklet is congregant-facing), editor+ write (same as weekly
    // editing). The frozen per-week snapshot lives on services/{date}.guide and
    // is covered by the services rule above. Components ship in code, not here.
    match /style_presets/{presetId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    match /page_templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    match /guide_templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    // Asset Library — reusable images (logos, QR codes) referenced by URL in pages.
    // Bytes live in Storage; this holds metadata + the public download URL.
    match /guide_assets/{assetId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // ── The People's Directory (MS-197, ADR-0031) ───────────────────────────
    //
    // ⚠ THE FLOOR IS AN ACCOUNT, NOT A RANK, AND THAT IS THE DECISION.
    // Until MS-197 this was `allow read: if true` — every name, email address,
    // phone number and home address, readable by anybody who could reach the
    // endpoint. Two ADRs accepted a smaller disclosure on the grounds that
    // this one was already out (ADR-0018 §Consequences, ADR-0020), and both
    // said the directory question was filed separately. This is that filing.
    //
    // `isMember()` looks like the tighter, better rule and is the wrong one. A
    // brand-new account has no Person and no rank; the way it gets one is the
    // Directory Request flow (ADR-0025, ADR-0027), where somebody searches the
    // directory for their own name and says "that is me". Gating the directory
    // on membership breaks the flow that MAKES people members. Storage already
    // draws the line here — a Directory Photo is `if request.auth != null`.
    //
    // What this does NOT do: sign-up is self-service, so this costs a stranger
    // an email address rather than nothing. That is the gate in front of this
    // lock and it is filed as MS-240.
    match /people/{personId} {
      // Kiosk is signed in (ADR-0041). isKiosk() is named so a later tightening
      // cannot drop the foyer machine without noticing the helper sitting here.
      allow read: if isSignedIn() || isKiosk();
      allow create, delete: if isEditor();
      allow create: if isKiosk();
      allow update: if isEditor();

      // Self-service (MS-87, ADR-0012): a Linked User may update ONLY their own
      // linked Person, and ONLY the self-editable fields — contact, birthday, and
      // sex while it is still unset. Membership (the Track), tags, and all
      // shepherding data are never self-editable. affectedKeys() reports the
      // top-level `contact` map when any contact sub-field changes, so listing
      // `contact` covers email/phone/address.
      // photoUrl/photoPath joined this set in ADR-0029: a photo is a fact about
      // you that only you have, and nothing else in the app reads it as an
      // identifier — unlike the name, which needs an editor (ADR-0027).
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contact', 'birthday', 'sex', 'photoUrl', 'photoPath', 'photoCrop', 'updatedAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sex'])
          || !('sex' in resource.data)
          || resource.data.sex == null
        );


      // What this named person has served, and when. Directory data about a
      // Person, so it moves with the Person (MS-197, ADR-0031).
      match /involvement/{involvementId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isEditor();
      }

      // Which named person was prayed for, and when. The public "was prayed
      // for" fact only — ADR-0007 keeps the request TEXT in the elder-only
      // prayer_requests subcollection below, and that stays true whatever this
      // rule says. Closed with the rest of the directory (MS-197, ADR-0031).
      match /pastoral_prayer_history/{historyId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isEditor();
      }

      // Prayer Requests are sensitive: visible to Elders/super admins only.
      // Keyed by service date so they line up with the order of service.
      match /prayer_requests/{requestId} {
        allow read, write: if isElder();
      }

      // Away (MS-188): stretches of whole days this Person said they will not
      // be here.
      //
      // ⚠ NOT A FIELD ON THE PERSON, AND THIS RULE IS STILL THE REASON.
      // When MS-188 wrote this, the Person document above was `allow read: if
      // true` and the argument was about the open internet. MS-197 closed the
      // directory to any signed-in account, and the argument survives it
      // intact, one rung lower: a name, an address and "away 10-24 August"
      // together say a particular house is empty on particular dates, and that
      // is not something to hand every account in the church. Rules are
      // per-path, so this subcollection stays narrower than its parent.
      //
      // The person themselves and editors above them, and nobody else. A member
      // has no business knowing who is on holiday, and every reader is blast
      // radius. It carries no reason — a *why* is pastoral and belongs in a
      // Shepherding Note, behind isElder().
      match /away/{stretchId} {
        allow read, create, update, delete: if isEditor()
          || (request.auth != null && personId == myPersonId());
      }
    }

    // Allow collection group queries for pastoral_prayer_history. Same
    // boundary as the per-person rule above (MS-197, ADR-0031) — a collection
    // group left open would be the whole church's history by another door.
    match /{path=**}/pastoral_prayer_history/{historyId} {
      allow read: if isSignedIn();
    }

    // Allow collection group queries for involvement (used by service injection
    // to re-key role assignments when services are shifted to a later Sunday).
    // Same boundary as the per-person rule above (MS-197, ADR-0031).
    match /{path=**}/involvement/{involvementId} {
      allow read: if isSignedIn();
    }

    // Away across everybody at once (MS-188) — what the person picker, the
    // fairness solve and auto-assign ask before they seat anyone. Editors and
    // above only, matching the per-person rule above; a member reading the whole
    // church's holidays is exactly what that rule exists to prevent.
    //
    // ⚠ Constrain this query. Firestore fails the WHOLE read if any returned
    // document would fail, so a member running it does not get their own rows
    // back — they get an error that reads like "nobody is ever away".
    match /{path=**}/away/{stretchId} {
      allow read: if isEditor();
    }

    // The directory's tag vocabulary, including which tags hide people. Read
    // by the directory, so it is closed with it (MS-197, ADR-0031).
    match /people_tags/{tagId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isEditor();
    }

    // Families (ADR-0012, MS-88): household entities for the Membership Directory.
    // Editor+ write (families are managed alongside People).
    //
    // Readable by any signed-in account, NOT by the world (MS-197, ADR-0031).
    // A Family is who is married to whom and whose children are whose, by
    // Person id — closing the names while leaving the household graph open
    // would have been a half fix.
    match /families/{familyId} {
      allow read: if isSignedIn() || isKiosk();
      allow create, update, delete: if isEditor();
    }

    // Households (MS-319): the foyer grouping. Distinct from Family. A Kiosk
    // may create one (and its People) on the spot; it cannot edit or delete
    // an existing Household or Person.
    match /households/{householdId} {
      allow read: if isSignedIn() || isKiosk();
      allow create: if isKiosk() || isEditor();
      // A Kiosk may only ADD (MS-321). The name may not change and nobody
      // already in may be dropped, so "put my brother in the Harris household"
      // is legal and renaming or emptying one is not. That is the whole
      // difference between a greeter and an editor, said in the rule rather
      // than trusted to the page — and it is what lets the kiosk grow a
      // household instead of minting a second one beside it.
      allow update: if isEditor() || (isKiosk()
        && (!('name' in resource.data) || request.resource.data.name == resource.data.name)
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAll(resource.data.memberIds));
      allow delete: if isEditor();
    }

    // Shepherding System — elders and super_admins only
    match /shepherding_tags/{tagId} {
      allow read, write: if isElder();
    }

    // Relationships (ADR-0012, MS-89; enriched by ADR-0014, MS-97): the
    // Custom Relationship layer. Pairwise Relationships are {fromId,toId,typeId}
    // edges; Relationship Groups are named rosters {typeId,name,leaderId,memberIds}.
    // Their shared vocabulary is the Relationship Types.
    //
    // Elder-only by default, and STILL never surfaced in the member-facing
    // directory. Since MS-128 there is exactly one door out: an elder may mark a
    // Relationship Type "Shared with Editors" so serving rules can use it
    // ("no married couple in Kids", "staff this Role from one house group").
    // Sharing a Type also shares the edges and rosters carrying it — MS-130
    // projects the decision onto each record so this rule can read it directly
    // rather than doing a get() per document, which would hit the rules engine's
    // lookup limits on any real list query.
    //
    // Fail closed: a record that does not say `true` is not shared. An absent
    // field compares unequal to true, so anything the backfill missed stays
    // private.
    //
    // ⚠ QUERY CONSTRAINT — read this before debugging an "empty" list.
    // Firestore evaluates these rules PER RETURNED DOCUMENT and fails the whole
    // query if any document would fail. A non-elder client MUST therefore filter
    // to shared records itself, e.g.
    //     .where('sharedWithEditors', '==', true)
    // An unconstrained query does not return fewer rows — it errors outright,
    // and the error looks exactly like "this church has no relationship types".
    function canReadRelationshipRecord() {
      return isElder() || (isEditor() && resource.data.sharedWithEditors == true);
    }

    match /relationships/{edgeId} {
      allow read: if canReadRelationshipRecord();
      allow write: if isElder();
    }
    match /relationship_types/{typeId} {
      allow read: if canReadRelationshipRecord();
      allow write: if isElder();
    }
    // A roster names everyone in it, so sharing one Group-kind Type is a larger
    // disclosure than sharing a pairwise Type. Deliberate (MS-141 needs group
    // membership for same-group / not-same-group serving rules), and still
    // entirely an elder's choice, Type by Type.
    match /relationship_groups/{groupId} {
      allow read: if canReadRelationshipRecord();
      allow write: if isElder();
    }

    match /shepherding_views/{viewId} {
      allow read, write: if isElder();
    }

    match /shepherding_reminders/{reminderId} {
      allow read, write: if isElder();
    }

    match /elder_meetings/{meetingId} {
      allow read, write: if isElder();
    }

    match /elder_documents/{docId} {
      allow read, write: if isElder();
    }

    match /elder_document_structure/{docId} {
      allow read, write: if isElder();
    }

    match /people/{personId}/shepherding_notes/{noteId} {
      allow read, write: if isElder();
    }

    // The Pastoral Record. Elder-only to read, and elder-only to change or
    // erase — with ONE hole, deliberately shaped.
    //
    // Moving somebody along the Membership Track is an editor's job (ADR-0012),
    // and ADR-0005 says the move and the Membership Change that records it land
    // in one batch or not at all. So refusing an editor the record refused them
    // the move: the whole batch bounced, and the slider came back with an error
    // and nothing changed.
    //
    // Appending that one entry is all the hole is. An editor still cannot READ
    // the Pastoral Record — the Track is theirs to walk, the pastoral history
    // around it is not — and cannot edit or delete an entry once written. The
    // entry must also be signed with their own uid: a record that could be
    // filed under somebody else's name is not a record.
    match /people/{personId}/shepherding_activity/{activityId} {
      allow read: if isElder();
      allow update, delete: if isElder();
      allow create: if isElder()
        || (isEditor()
            && request.resource.data.kind == 'membership_change'
            && request.resource.data.authorUid == request.auth.uid);
    }

    // Collection group query for shepherding_notes (used by People list page)
    match /{path=**}/shepherding_notes/{noteId} {
      allow read: if isElder();
    }

    // Collection group query for shepherding_activity (Tag Changes), used by the
    // Shepherd Landing Page to derive Tag Hold for the Hold-Duration filter.
    match /{path=**}/shepherding_activity/{activityId} {
      allow read: if isElder();
    }

    // Inbound replies to SMS test texts. Written only by the smsInbound webhook
    // (admin SDK, bypasses rules); admins read and clear them from the Admin
    // Dashboard. No client writes.
    match /sms_test_replies/{replyId} {
      allow read, delete: if isAdmin();
    }

    // App-wide config edited from the Admin Dashboard (e.g. the prayer-request
    // SMS message templates and the automation kill switch). The server reads
    // these via the admin SDK.
    match /app_config/{configId} {
      allow read, write: if isAdmin();
    }

    // Outbound SMS log — written only by the server (admin SDK) and read by
    // admins for the audit/status readout. No client writes.
    match /sms_messages/{messageId} {
      allow read: if isAdmin();
    }

    // Who is editing what, right now (MS-246). One document per signed-in
    // editor, at their own uid, saying which box on which Sunday they are in.
    // Everything here is transient — a claim is a heartbeat that expires after
    // half a minute, and nothing reads this collection except the live badges.
    //
    // ⚠ THE DOCUMENT ID IS THE LOCK. Keying by uid is what makes "one person
    // per box" enforceable rather than merely agreed: you can only ever write
    // the document named after you, so nobody can release, steal or forge
    // somebody else's claim by writing over it. A collection keyed any other
    // way would leave the whole scheme on the honour system.
    //
    // Readable by editors only. It carries names and photo URLs of people
    // working on services, which is nothing secret, but it is also of no use
    // to anybody who cannot edit — and the Service Calendar is a page an
    // anonymous visitor can open.
    match /presence/{uid} {
      allow read: if isEditor();
      allow write, delete: if isEditor() && request.auth.uid == uid;
    }

    // ── The MCP server's front door (MS-262, ADR-0038) ──────────────────
    //
    // ⚠ NO CLIENT MAY TOUCH ANY OF THESE, EVER — not even an admin, and not
    // even to read. They hold the machinery that decides who may edit the
    // Order of Service from outside the website: registered assistants,
    // in-flight sign-ins, single-use authorization codes, and the hashed
    // record of every live pass.
    //
    // The Admin SDK ignores these rules, which is precisely the point: only
    // functions/mcp-auth.js can reach this data, and it is the only thing
    // that should. A read path here would be a way to enumerate live
    // sessions; a write path would be a way to mint yourself a pass.
    //
    // `mcp_tokens` is keyed by the SHA-256 of a token and never contains the
    // token itself, so even a copy of it grants nothing — but that is a
    // second line of defence, not a reason to soften the first.
    match /mcp_clients/{clientId} {
      allow read, write: if false;
    }
    match /mcp_auth_requests/{requestId} {
      allow read, write: if false;
    }
    match /mcp_auth_codes/{code} {
      allow read, write: if false;
    }
    match /mcp_tokens/{tokenHash} {
      allow read, write: if false;
    }

    // The guidance files an assistant pulls down through the MCP — the
    // church's standing instructions for building an Order of Service
    // (MS-262). Authored by editors on the MCP Manager page.
    //
    // ⚠ UNLIKE THE mcp_* COLLECTIONS ABOVE, THIS IS CONTENT, NOT MACHINERY.
    // Those hold passes and codes and are sealed from every client. This
    // holds writing that editors are meant to change, so it is editor+ read
    // and write — the same rung as everything else they author.
    //
    // ⚠ WHOEVER CAN WRITE HERE CAN STEER THE ASSISTANT. A guidance file is
    // read as instruction, so this is not merely another content collection:
    // it is the one place where changing a document changes what the
    // assistant does. Editor+ is deliberate — the same people already
    // trusted to rewrite a Sunday directly — and it must not be widened to
    // members on the grounds that "it is only text".
    match /mcp_guidance/{fileId} {
      allow read: if isEditor();
      allow create, update, delete: if isEditor();

      // The edit history. Editors READ it — that is the whole point, since
      // it is what lets a bad change be spotted and rewound — but nobody
      // writes it from a browser.
      //
      // ⚠ WRITTEN ONLY BY THE onGuidanceWritten TRIGGER, which the Admin
      // SDK runs past these rules. A client write path here would let
      // somebody edit the record of what they changed, which is the one
      // thing a history must not allow: an account that can be edited by
      // the person it is accounting for is not a history, it is a claim.
      // Restoring an old version does NOT write here either — it writes the
      // parent document, and the trigger files the restore as a new entry.
      match /versions/{versionId} {
        allow read: if isEditor();
        allow write: if false;
      }
    }
  }
}
