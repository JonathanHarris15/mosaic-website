rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Effective permission level for the signed-in user. Reads the new
    // `permissionLevel` field, falling back to the legacy `role` field during the
    // MS-119 migration while both coexist (MS-127 drops `role` afterwards).
    // Callers guard on request.auth first, so this get() only runs when signed in.
    function permissionLevel() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('permissionLevel' in d) ? d.permissionLevel : d.role;
    }

    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && permissionLevel() in ['admin', 'super_admin'];
    }

    // Helper to check if user is editor
    function isEditor() {
      return request.auth != null && permissionLevel() in ['editor', 'admin', 'elder', 'super_admin'];
    }

    // Helper to check if user is a member or above. The floor of the `member`
    // visibility rung (MS-99): a viewer is signed in but sees only public things.
    function isMember() {
      return request.auth != null
        && permissionLevel() in ['member', 'editor', 'admin', 'elder', 'super_admin'];
    }

    // The Person record this signed-in User is linked to, or null. Event
    // `participant` visibility is answered against Person ids, not User ids.
    function myPersonId() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('personId' in d) ? d.personId : null;
    }

    // Helper to check if user is elder or super_admin
    function isElder() {
      return request.auth != null && permissionLevel() in ['elder', 'super_admin'];
    }

    match /users/{userId} {
      // Allow users to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow users to create their own document as 'viewer' (permission level).
      // During the MS-119 migration the client writes both permissionLevel and the
      // legacy role; accept whichever the new doc carries.
      allow create: if request.auth != null && request.auth.uid == userId
        && (('permissionLevel' in request.resource.data)
            ? request.resource.data.permissionLevel == 'viewer'
            : request.resource.data.role == 'viewer');
      // Allow users to update ONLY their own dashboard card arrangement.
      // Restricting the affected keys prevents self role-escalation or tampering
      // with any other field (email, personId, etc.).
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dashboardCardOrder']);
      // Allow admins to read and write any user document
      allow read, write: if isAdmin();
    }

    // Directory Requests (ADR-0025, ADR-0027): anything a person asks the church
    // to change about their own directory record — connect me to a record, add
    // me to the directory, fix my name's spelling, record my household.
    //
    // Document ids are namespaced `${uid}_...`, and this rule REQUIRES it. That
    // is what keeps one person's requests out of everyone else's namespace
    // without the rules having to trust a field, and it is why a second ask of
    // the same kind overwrites the first instead of piling up.
    //
    // Note what is missing: there is no `allow update`. Resolving a request
    // writes users/{uid}.personId, people/{id}.name, or the families
    // collection — on behalf of someone who may be a plain member. A rule wide
    // enough to let an editor approve here would be a rule wide enough to let
    // them change permission levels. So approval goes through the
    // resolveDirectoryRequest callable, which runs with admin privileges and
    // bypasses these rules entirely. No browser ever updates a request.
    match /directory_requests/{requestId} {
      // The requester sees their own; editors, elders and admins see the queue.
      allow read: if request.auth != null
        && (requestId.matches(request.auth.uid + '_.*') || isEditor());

      // You may only ask on your own behalf, only as pending, and only in your
      // own id namespace. A link request additionally requires that you are not
      // already linked — an existing link is the thing it is for.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && requestId.matches(request.auth.uid + '_.*')
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['link_match', 'link_new', 'name_fix', 'family']
        && (
          !(request.resource.data.kind in ['link_match', 'link_new'])
          || myPersonId() == null
        )
        // A name fix or a family change is only ever about your OWN Person.
        && (
          !(request.resource.data.kind in ['name_fix', 'family'])
          || request.resource.data.personId == myPersonId()
        );

      // Withdraw your own request (and so file a fresh one after a decline);
      // approvers may clear resolved requests out of the queue. Deleting a
      // request never touches what it asked for.
      allow delete: if request.auth != null
        && (requestId.matches(request.auth.uid + '_.*') || isEditor());
    }

    match /hymns/{hymnId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    
    match /tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // Servant Role Definitions (ADR-0016, MS-13): name, ordered slots, and
    // restriction rules read against existing Tags and Relationships. Authored
    // in the Roles Manager by editors; read like the other config collections so
    // any surface showing who is serving can name the Role. Liturgical Roles are
    // NOT here — they are code-defined and locked, so there is nothing to store.
    match /roles/{roleId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // ── Events, occurrences, and the five-rung visibility ladder ────────────
    //
    // ADR-0018 §5. Visibility is `public` → `member` → `participant` → `editor`
    // → `elder`, and it is STAMPED ONTO EVERY OCCURRENCE rather than looked up
    // from the series. A rule cannot afford a get() per row without hitting the
    // rules engine's lookup limits on any real list query — the lesson already
    // learned in MS-130 for the relationship collections.
    //
    // FAILS CLOSED. Every clause tests the stamped value for equality against a
    // named rung, so a document with no `visibility` field matches nothing and is
    // readable by nobody. That is deliberate: the failure mode being guarded
    // against is an occurrence quietly shipping unstamped and going public.
    //
    // ⚠ QUERY CONSTRAINT — read this before debugging an "empty" calendar.
    // Firestore evaluates these rules PER RETURNED DOCUMENT and fails the WHOLE
    // query if any document would fail. The Calendar MUST therefore constrain its
    // own reads — one query filtered by the viewer's rank, one `array-contains`
    // their Person id, merged client-side, because Firestore cannot express that
    // as a single filter:
    //     .where('visibility', 'in', rungsForMyRank)
    //     .where('participantIds', 'array-contains', myPersonId)
    // An unconstrained query does not return fewer rows — it errors outright, and
    // the error looks exactly like "this church has no events".
    // EventsOccurrenceCore.visibilityQueryFor() is the one place that builds them.

    // The stamped rung, or 'none' when the field is absent. 'none' is not a rung,
    // so an unstamped document is readable by nobody.
    function stampedVisibility() {
      return ('visibility' in resource.data) ? resource.data.visibility : 'none';
    }

    // Rank alone. `participant` is NOT here for a member — it cannot be answered
    // by rank, which is the whole reason the Calendar runs a second query — but
    // everyone above participant sees participant-level Events without holding a
    // Role on them.
    function rankCanSee(visibility) {
      return visibility == 'public'
        || (isMember() && visibility == 'member')
        || (isEditor() && visibility in ['member', 'participant', 'editor'])
        || (isElder() && visibility == 'elder');
    }

    // The one rung rank cannot answer, checked against the occurrence's own
    // denormalised participant list. Someone who DECLINED is still in that list —
    // they keep their place, and their sight of the Event, until somebody else
    // takes the slot. Someone removed by an editor leaves the list in the same
    // write, and loses sight of it instantly.
    function isEventParticipant() {
      return request.auth != null
        && ('participantIds' in resource.data)
        && myPersonId() in resource.data.participantIds;
    }

    // Event series (ADR-0016, MS-13; visibility added by ADR-0018): the recurring
    // things that carry Roles.
    //
    // NO LONGER WORLD-READABLE. Harmless while the only series was the Sunday
    // Service; the moment "Elders' Meeting" can be a series, its name would be
    // public to the internet.
    //
    // The Sunday Service is permanently public and is named here rather than
    // relying on a stamp, so the Services page and the congregant-facing Service
    // Guide keep working exactly as they do today, with no migration in between.
    //
    // A series carries no participant list — participation is per occurrence — so
    // `participant`-level series are reachable by editors and above only. A
    // participant does not need the series: an Event they hold a Role on always
    // HAS an occurrence document (that is where their assignment lives), and the
    // occurrence carries everything the Calendar renders.
    match /events/{eventId} {
      allow read: if eventId == 'sunday_service' || rankCanSee(stampedVisibility());
      allow create, update, delete: if isEditor();
    }

    // Event occurrences (ADR-0018 §3): the dated instances. SPARSE — a document
    // exists only once something lands on the date, so an untouched date still
    // appears in the Calendar, computed from the series' recurrence rule.
    match /event_occurrences/{occurrenceId} {
      allow read: if rankCanSee(stampedVisibility())
        || (stampedVisibility() == 'participant' && isEventParticipant());
      allow create, update, delete: if isEditor();

      // The roster — who else is serving. Firestore cannot hide a FIELD from
      // someone allowed to read a document, so "participants can't see who else
      // is coming" only works if the roster is stored separately (ADR-0018 §5).
      //
      // Your OWN assignment is always readable — you are always allowed to know
      // what you have been asked to do. Everyone else's depends on the Event's
      // roster setting, which is the editor's choice per Event.
      match /roster/{assignmentId} {
        allow read: if isEditor()
          || (request.auth != null && resource.data.personId == myPersonId())
          || (request.auth != null
              && get(/databases/$(database)/documents/event_occurrences/$(occurrenceId)).data.rosterShared == true
              && myPersonId() in get(/databases/$(database)/documents/event_occurrences/$(occurrenceId)).data.participantIds);
        allow create, update, delete: if isEditor();
      }
    }

    // The Calendar needs YOUR OWN assignments across a whole month without
    // reading anybody else's, so it queries each Event's roster for your Person
    // id. Your own row is always readable — you are always allowed to know what
    // you have been asked to do — and everyone else's still depends on the
    // Event's roster setting via the rule above.
    //
    // ⚠ Constrain this query. `.where('personId', '==', myPersonId)` is what
    // makes it legal; unconstrained it returns other people's rows, they fail,
    // and the whole read errors.
    match /{path=**}/roster/{assignmentId} {
      allow read: if isEditor()
        || (request.auth != null && resource.data.personId == myPersonId());
    }

    match /services/{dateId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // Service Guide Template System (ADR-0008). The Page Library, Style Presets,
    // and Service Guide Templates are global, editor-authored content — public
    // read (the booklet is congregant-facing), editor+ write (same as weekly
    // editing). The frozen per-week snapshot lives on services/{date}.guide and
    // is covered by the services rule above. Components ship in code, not here.
    match /style_presets/{presetId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    match /page_templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    match /guide_templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    // Asset Library — reusable images (logos, QR codes) referenced by URL in pages.
    // Bytes live in Storage; this holds metadata + the public download URL.
    match /guide_assets/{assetId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /people/{personId} {
      allow read: if true;
      allow create, delete: if isEditor();
      allow update: if isEditor();

      // Self-service (MS-87, ADR-0012): a Linked User may update ONLY their own
      // linked Person, and ONLY the self-editable fields — contact, birthday, and
      // sex while it is still unset. Membership (the Track), tags, and all
      // shepherding data are never self-editable. affectedKeys() reports the
      // top-level `contact` map when any contact sub-field changes, so listing
      // `contact` covers email/phone/address.
      // photoUrl/photoPath joined this set in ADR-0029: a photo is a fact about
      // you that only you have, and nothing else in the app reads it as an
      // identifier — unlike the name, which needs an editor (ADR-0027).
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contact', 'birthday', 'sex', 'photoUrl', 'photoPath', 'updatedAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sex'])
          || !('sex' in resource.data)
          || resource.data.sex == null
        );


      match /involvement/{involvementId} {
        allow read: if true;
        allow create, update, delete: if isEditor();
      }

      match /pastoral_prayer_history/{historyId} {
        allow read: if true;
        allow create, update, delete: if isEditor();
      }

      // Prayer Requests are sensitive: visible to Elders/super admins only.
      // Keyed by service date so they line up with the order of service.
      match /prayer_requests/{requestId} {
        allow read, write: if isElder();
      }

      // Away (MS-188): stretches of whole days this Person said they will not
      // be here.
      //
      // ⚠ NOT A FIELD ON THE PERSON, AND THIS RULE IS THE REASON. The Person
      // document above is `allow read: if true` — every name, email, phone
      // number and home address, readable by anyone at all. ADR-0018 accepted
      // that posture for `participantIds` because ids disclose little that is
      // not already out. It does not stretch to this: a name, an address and
      // "away 10-24 August" together say a particular house is empty on
      // particular dates. Rules are per-path, so this subcollection is closed
      // even though its parent is open.
      //
      // The person themselves and editors above them, and nobody else. A member
      // has no business knowing who is on holiday, and every reader is blast
      // radius. It carries no reason — a *why* is pastoral and belongs in a
      // Shepherding Note, behind isElder().
      match /away/{stretchId} {
        allow read, create, update, delete: if isEditor()
          || (request.auth != null && personId == myPersonId());
      }
    }

    // Allow collection group queries for pastoral_prayer_history
    match /{path=**}/pastoral_prayer_history/{historyId} {
      allow read: if true;
    }

    // Allow collection group queries for involvement (used by service injection
    // to re-key role assignments when services are shifted to a later Sunday)
    match /{path=**}/involvement/{involvementId} {
      allow read: if true;
    }

    // Away across everybody at once (MS-188) — what the person picker, the
    // fairness solve and auto-assign ask before they seat anyone. Editors and
    // above only, matching the per-person rule above; a member reading the whole
    // church's holidays is exactly what that rule exists to prevent.
    //
    // ⚠ Constrain this query. Firestore fails the WHOLE read if any returned
    // document would fail, so a member running it does not get their own rows
    // back — they get an error that reads like "nobody is ever away".
    match /{path=**}/away/{stretchId} {
      allow read: if isEditor();
    }

    match /people_tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // Families (ADR-0012, MS-88): household entities for the Membership Directory.
    // Public read (the directory shows households to the congregation); editor+
    // write (families are managed alongside People).
    match /families/{familyId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // Shepherding System — elders and super_admins only
    match /shepherding_tags/{tagId} {
      allow read, write: if isElder();
    }

    // Relationships (ADR-0012, MS-89; enriched by ADR-0014, MS-97): the
    // Custom Relationship layer. Pairwise Relationships are {fromId,toId,typeId}
    // edges; Relationship Groups are named rosters {typeId,name,leaderId,memberIds}.
    // Their shared vocabulary is the Relationship Types.
    //
    // Elder-only by default, and STILL never surfaced in the member-facing
    // directory. Since MS-128 there is exactly one door out: an elder may mark a
    // Relationship Type "Shared with Editors" so serving rules can use it
    // ("no married couple in Kids", "staff this Role from one house group").
    // Sharing a Type also shares the edges and rosters carrying it — MS-130
    // projects the decision onto each record so this rule can read it directly
    // rather than doing a get() per document, which would hit the rules engine's
    // lookup limits on any real list query.
    //
    // Fail closed: a record that does not say `true` is not shared. An absent
    // field compares unequal to true, so anything the backfill missed stays
    // private.
    //
    // ⚠ QUERY CONSTRAINT — read this before debugging an "empty" list.
    // Firestore evaluates these rules PER RETURNED DOCUMENT and fails the whole
    // query if any document would fail. A non-elder client MUST therefore filter
    // to shared records itself, e.g.
    //     .where('sharedWithEditors', '==', true)
    // An unconstrained query does not return fewer rows — it errors outright,
    // and the error looks exactly like "this church has no relationship types".
    function canReadRelationshipRecord() {
      return isElder() || (isEditor() && resource.data.sharedWithEditors == true);
    }

    match /relationships/{edgeId} {
      allow read: if canReadRelationshipRecord();
      allow write: if isElder();
    }
    match /relationship_types/{typeId} {
      allow read: if canReadRelationshipRecord();
      allow write: if isElder();
    }
    // A roster names everyone in it, so sharing one Group-kind Type is a larger
    // disclosure than sharing a pairwise Type. Deliberate (MS-141 needs group
    // membership for same-group / not-same-group serving rules), and still
    // entirely an elder's choice, Type by Type.
    match /relationship_groups/{groupId} {
      allow read: if canReadRelationshipRecord();
      allow write: if isElder();
    }

    match /shepherding_views/{viewId} {
      allow read, write: if isElder();
    }

    match /shepherding_reminders/{reminderId} {
      allow read, write: if isElder();
    }

    match /elder_meetings/{meetingId} {
      allow read, write: if isElder();
    }

    match /elder_documents/{docId} {
      allow read, write: if isElder();
    }

    match /elder_document_structure/{docId} {
      allow read, write: if isElder();
    }

    match /people/{personId}/shepherding_notes/{noteId} {
      allow read, write: if isElder();
    }

    match /people/{personId}/shepherding_activity/{activityId} {
      allow read, write: if isElder();
    }

    // Collection group query for shepherding_notes (used by People list page)
    match /{path=**}/shepherding_notes/{noteId} {
      allow read: if isElder();
    }

    // Collection group query for shepherding_activity (Tag Changes), used by the
    // Shepherd Landing Page to derive Tag Hold for the Hold-Duration filter.
    match /{path=**}/shepherding_activity/{activityId} {
      allow read: if isElder();
    }

    // Inbound replies to SMS test texts. Written only by the smsInbound webhook
    // (admin SDK, bypasses rules); admins read and clear them from the Admin
    // Dashboard. No client writes.
    match /sms_test_replies/{replyId} {
      allow read, delete: if isAdmin();
    }

    // App-wide config edited from the Admin Dashboard (e.g. the prayer-request
    // SMS message templates and the automation kill switch). The server reads
    // these via the admin SDK.
    match /app_config/{configId} {
      allow read, write: if isAdmin();
    }

    // Outbound SMS log — written only by the server (admin SDK) and read by
    // admins for the audit/status readout. No client writes.
    match /sms_messages/{messageId} {
      allow read: if isAdmin();
    }
  }
}
