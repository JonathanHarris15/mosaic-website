# Firebase service account keys (never commit credentials)
*firebase-adminsdk*.json
serviceAccountKey.json

# Android release signing (losing the keystore means you cannot ship updates —
# back it up somewhere safe, but never in the repo)
android/keystore.properties
android/local.properties
*.jks
*.keystore

# App Store Connect API key + machine-specific release config (secrets — never commit)
*.p8
mobile-release.local.json

# In-project secrets folder (keystore + ASC key — never commit)
Secrets/

# Mobile build outputs
android/app/build/
ios/App/build/
build/mobile/

# Node modules
node_modules/

.venv/

# Firebase
.firebase/

# Misc
examples/

# Logs
*.log
firebase-debug.log
firestore-debug.log
cmdline-tools.zip

# Claude Code local settings (personal permission grants, not shared)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# macOS Finder metadata (icon positions — nothing to do with the project)
.DS_Store

# Throwaway spike outputs (vectors + generated reports)
scripts/spike/vectors-*.json
scripts/spike/report-*.md
scripts/spike/themes.json
