# Firebase service account keys (never commit credentials)
*firebase-adminsdk*.json
serviceAccountKey.json

# Android release signing (losing the keystore means you cannot ship updates —
# back it up somewhere safe, but never in the repo)
android/keystore.properties
android/local.properties
*.jks
*.keystore

# App Store Connect API key + machine-specific release config (secrets — never commit)
*.p8
mobile-release.local.json

# In-project secrets folder (keystore + ASC key — never commit)
Secrets/

# Mobile build outputs
android/app/build/
ios/App/build/
build/mobile/

# Node modules
node_modules/

.venv/

# Firebase
.firebase/

# Misc
examples/

# Logs
*.log
firebase-debug.log
firestore-debug.log
cmdline-tools.zip

# Claude Code local settings (personal permission grants, not shared)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# macOS Finder metadata (icon positions — nothing to do with the project)
.DS_Store

# Throwaway spike outputs (vectors + generated reports)
scripts/spike/vectors-*.json
scripts/spike/report-*.md
scripts/spike/themes.json

# Firebase param values written by `firebase deploy` (functions/.env.<project>).
# This one only ever held MCP_ISSUER_URL, which is a public address — but a
# param file is exactly where a secret would land next, and a deploy writes it
# without being asked. Ignored so that cannot happen quietly. The values that
# matter have defaults in functions/index.js, and test/mcp-hosting.test.js
# pins the issuer to the hosting site, so a clean checkout needs no secrets
# to deploy correctly.
functions/.env.*

# Board conversation logs (.board/conversations/*.json|md) — the working notes
# the ticket skills leave behind as they plan and implement. They are a record
# of how a ticket was talked through, not part of the app, and they change every
# time anything touches the board. Ignored so they stop showing up as untracked
# noise in every status. Its README stays: it explains what the directory is,
# and that the logs in it are safe to delete.
#
# The CONTENTS are ignored rather than the directory, because git cannot
# re-include a file inside an excluded directory.
.board/conversations/*
!.board/conversations/README.md
