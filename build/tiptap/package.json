{
  "name": "mosaic-tiptap-bundle",
  "private": true,
  "description": "Isolated build for the offline TipTap bundle used by the mobile shell's native Care List editor. Kept out of the app's root deps. Run `npm run vendor:tiptap` from the repo root to (re)build public/vendor/tiptap/tiptap.bundle.js.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-table-of-contents": "^2.27.2",
    "@tiptap/extension-mention": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "esbuild": "^0.28.1",
    "prosemirror-state": "^1.4.4"
  }
}
