rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Directory photos (ADR-0029). Storage rules cannot read Firestore, so they
    // cannot tell whether this uploader owns this personId — that check lives in
    // the Firestore rule on `people`, which is what decides whether an uploaded
    // image can ever be ATTACHED to a Person. Bytes nobody can attach are inert.
    //
    // What IS enforceable here is the shape of the upload, and that is worth
    // enforcing: without it this path accepts an executable, or a 2GB file, from
    // any signed-in account.
    match /people_photos/{personId}/{fileId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // No client deletes. These rules cannot tell whose photo this is, so
      // allowing delete here would let any signed-in account wipe anyone's.
      // The cleanUpReplacedPhoto trigger removes a replaced blob instead —
      // which also catches the browser that closes mid-upload.
      allow delete: if false;
    }

    // ── Who is asking, in Firestore's terms ──────────────────────────────────
    //
    // Cross-service Rules: a Storage rule may read Cloud Firestore. The budget
    // is TWO documents per evaluation and no more, so everything below is
    // arranged to spend exactly two — the asker's `users` document and the
    // occurrence — and never the same one twice.
    //
    // These restate `permissionLevel()`, `isSignedIn()` and `rankCanSee()` from
    // firestore.rules in a second engine that cannot import them. That
    // duplication is real and it is the price of the boundary being enforced
    // where the bytes are; test/storage-event-attachment-rules.test.js reads
    // both files and fails when they drift apart.

    function myUserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // `permissionLevel` with the legacy `role` fallback, exactly as
    // firestore.rules reads it during the MS-119 migration.
    function levelOf(u) {
      return ('permissionLevel' in u) ? u.permissionLevel : u.role;
    }

    // ⚠ Anonymous sign-in is enabled on this project, so `request.auth != null`
    // is NOT "signed in" — same trap firestore.rules documents at length.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ── What the occurrence says about itself ────────────────────────────────
    //
    // An occurrence with no `visibility` field reads as 'none' and matches
    // nothing, so a document that ships unstamped is invisible rather than
    // public — the same fail-closed default firestore.rules takes. A missing
    // occurrence fails the same way: `.data` on nothing denies.

    function stampedVisibility(occ) {
      return ('visibility' in occ) ? occ.visibility : 'none';
    }

    // rankCanSee(), plus the one rung rank alone cannot answer: `participant`
    // is decided against the occurrence's own list of Person ids.
    function rankOrParticipantSees(occ, u) {
      return (stampedVisibility(occ) == 'member'
              && (levelOf(u) in ['member', 'editor', 'admin', 'elder', 'super_admin', 'pastoral_assistant']
                  || u.pastoralAssistant == true))
        || (stampedVisibility(occ) in ['member', 'participant', 'editor']
              && (levelOf(u) in ['editor', 'admin', 'elder', 'super_admin', 'pastoral_assistant']
                  || u.pastoralAssistant == true))
        || (stampedVisibility(occ) == 'elder'
              && (levelOf(u) in ['elder', 'super_admin']
                  || levelOf(u) == 'pastoral_assistant'
                  || u.pastoralAssistant == true))
        || (stampedVisibility(occ) == 'participant'
              && ('personId' in u) && ('participantIds' in occ)
              && u.personId in occ.participantIds);
    }

    // A public occurrence is answered without reading the asker at all, so a
    // signed-out request never reaches a get() on `users/`.
    function canSeeOccurrence(occurrenceId) {
      return canSee(
        firestore.get(/databases/(default)/documents/event_occurrences/$(occurrenceId)).data
      );
    }

    function canSee(occ) {
      return stampedVisibility(occ) == 'public'
        || (isSignedIn() && rankOrParticipantSees(occ, myUserDoc()));
    }

    function isEditorAccount() {
      return isSignedIn() && (
        levelOf(myUserDoc()) in ['editor', 'admin', 'elder', 'super_admin', 'pastoral_assistant']
        || isPastoralAssistantAccount()
      );
    }

    // ⚠ AN ADMIN IS NOT AN ELDER. The tier list reads editor → elder → admin,
    // which suggests an admin sees everything an elder does; isElder() in
    // firestore.rules has never said so, and this restates that one rather than
    // the tier list. Shepherding data is closed to admins on purpose.
    function isElderAccount() {
      return isSignedIn() && levelOf(myUserDoc()) in ['elder', 'super_admin'];
    }

    // Pastoral Assistant is the permission level, restated from AccessCore
    // (ADR-0076). The old flag still counts. Fail closed: neither is a grant
    // when the user doc is missing. Not an elder.
    function isPastoralAssistantAccount() {
      return isSignedIn() && (
        levelOf(myUserDoc()) == 'pastoral_assistant'
        || myUserDoc().pastoralAssistant == true
      );
    }

    function readsAsElderAccount() {
      return isElderAccount() || isPastoralAssistantAccount();
    }

    function readsAsEditorAccount() {
      return isEditorAccount() || isPastoralAssistantAccount();
    }

    // The floor of the `member` rung, restating firestore.rules isMember().
    // Note what it is not: `request.auth != null`, which on this project is a
    // self-service account with no rung at all.
    function isMemberAccount() {
      return isSignedIn() && (
        levelOf(myUserDoc()) in ['member', 'editor', 'admin', 'elder', 'super_admin', 'pastoral_assistant']
        || isPastoralAssistantAccount()
      );
    }

    // MS-722 / MS-725 (ADR 0082): the permission-key write door, restated.
    // A saved map is the whole answer when there is one; an account that has
    // never been through Admin → Accounts keeps the level names. Same three
    // clauses as firestore.rules editsWith(), in the engine that cannot
    // import them.
    function usesPermissionMapAccount() {
      return isSignedIn() && ('permissions' in myUserDoc());
    }

    function hasPermissionAccount(key) {
      return usesPermissionMapAccount()
        && myUserDoc().permissions[key] == true;
    }

    function editsWithAccount(key) {
      return hasPermissionAccount(key)
        || (!usesPermissionMapAccount() && isEditorAccount());
    }

    // MS-594: restates AccessCore.canDecide. Storage has no elder-only
    // shepherding write path today; the helper is here so the restatement
    // cannot drift from Firestore / the core.
    function canDecideAccount() {
      return isElderAccount() || isPastoralAssistantAccount();
    }

    // Event Attachments (MS-287): a file attached to one Event occurrence — a
    // flyer, a sign-up sheet, a floor plan, whatever file type the church
    // needs.
    //
    // READ IS THE OCCURRENCE'S OWN VISIBILITY, not "signed in". Unlike a
    // Directory Photo, an Event has a restrictive rung to under-deliver on:
    // the elders' meeting is elder-only, and its floor plan being a plain file
    // any signed-in account could fetch by path made the rung a decoration.
    // The rule now reads the occurrence's stamped visibility out of Firestore
    // and answers the same question the Firestore rule on
    // `event_occurrences/{id}/attachments` answers about the record pointing
    // here. Whoever may see the Event may see what is attached to it, and
    // nobody else — one sentence, now true in both places.
    //
    // ⚠ THIS RULE IS ONLY HALF THE BOUNDARY. `getDownloadURL()` mints a token
    // that bypasses these rules entirely and never expires, so nothing may
    // ever call it on this path — a single forwarded link would undo
    // everything above, permanently, for a signed-out stranger. Two things
    // keep that shut: the browser downloads through an authenticated request
    // (calendar-event.js `openAttachment`), which IS checked here on every
    // fetch; and `sealEventAttachment` strips the token Storage mints at
    // upload, so there is none left to hand out. See ADR-0046.
    //
    // No content-type restriction, deliberately — "any file type" is the
    // whole point (confirmed on the ticket: not a Google Drive integration,
    // just accepting lots of file types into our own Storage). The size cap
    // matches `EventAttachmentsCore.MAX_ATTACHMENT_BYTES`, which the browser
    // refuses at before the upload even starts.
    match /event_attachments/{occurrenceId}/{attachmentId}/{fileName} {
      allow read: if canSeeOccurrence(occurrenceId);

      // Only an editor uploads, which these rules CAN now answer. Before
      // cross-service reads this said "signed in", and a member could park
      // 25MB under any occurrence id they could guess.
      allow write: if isEditorAccount()
        && request.resource.size < 25 * 1024 * 1024;

      // No client deletes — same reasoning as Directory Photos. Deleting the
      // bytes is the one thing an editor should not do directly: the record
      // is the truth, and `cleanUpDeletedAttachment` removes the blob once the
      // Firestore record pointing at it is gone.
      allow delete: if false;
    }

    // What somebody sent with a form answer (MS-389).
    //
    // ⚠ WRITE IS FALSE, FOR EVERYBODY, AND THAT IS THE DESIGN RATHER THAN AN
    // OVERSIGHT.
    //
    // Somebody answering a public form has no account, and every client rule in
    // this file requires one. There is no rule that
    // could let them upload without opening the bucket to the world. So the
    // bytes go through the same closed door as every other public write: the
    // `publicForm` Cloud Function, which runs past these rules with admin
    // credentials (ADR-0051).
    //
    // That leaves nothing for a client to do here, and `if false` says so
    // better than any condition could: it needs no reasoning about who is
    // asking, and it cannot be loosened by accident.
    //
    // ⚠ AND NOTHING MAY EVER CALL getDownloadURL() ON THIS PATH. It mints a
    // token that bypasses everything above and never expires, so one forwarded
    // link would undo this permanently (ADR-0046). The upload is written with
    // an empty token and the Responses tab fetches it as the signed-in reader,
    // which IS checked here on every request.
    //
    // Read is editor-and-above, restating `isEditor()` from firestore.rules in
    // an engine that cannot import it — the same duplication event_attachments
    // already accepts, and test/storage-form-upload-rules.test.js fails when
    // the two drift.
    match /form_uploads/{formId}/{responseId}/{fileName} {
      allow read: if readsAsEditorAccount();
      allow write: if false;
      allow delete: if false;
    }

    // The same files, for a form an elder has shut to elders (MS-404).
    //
    // ⚠ WHY A SECOND PATH RATHER THAN A FLAG. Whoever may read an answer may
    // read what came with it, and firestore.rules shuts an elder-only form's
    // answers to every editor who is not an elder. This engine cannot see that
    // stamp, and reaching into Firestore per file would put a lookup on every
    // read of every attachment. So the function writes the fact into the path,
    // the way the answer carries it in a field, and the rule reads it here.
    //
    // A file written to the wrong prefix is a file behind the wrong door, so
    // the prefix is chosen in ONE place — fp.uploadPath — and the record keeps
    // the path it actually wrote.
    match /form_uploads_elder/{formId}/{responseId}/{fileName} {
      allow read: if readsAsElderAccount();
      allow write: if false;
      allow delete: if false;
    }

    // Pictures placed on a Printable (MS-394): a logo, a cover photo, or a
    // fill-in image typed on a linked date. Like a Directory Photo (ADR-0029)
    // the client keeps getDownloadURL() on the element. Write restates who may
    // fill in printables in the app (AccessCore.writesAsEditor / Firestore
    // printables.edit and services.builder.edit) — not isEditorAccount() alone,
    // which MS-769 left behind when the catch-all went away.
    match /printable_assets/{printableId}/{fileId} {
      allow read: if isSignedIn();
      allow write: if (editsWithAccount('printables.edit')
          || editsWithAccount('services.builder.edit'))
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Country map on a Sunday's typed booklet text (MS-591). The Sunday
    // record keeps an https URL, not the bytes — Firestore cannot hold
    // an unbounded data URL. Write matches services/{date} (services.builder.edit).
    match /sunday_typed/{dateId}/country_map/{fileId} {
      allow read: if isSignedIn();
      allow write: if (editsWithAccount('services.builder.edit')
          || editsWithAccount('printables.edit'))
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // The Resources library (MS-693, ADR-0083): the church's shelf of studies,
    // manuscripts, outlines and packets. One resource record, one prefix named
    // after its id, one file inside it.
    //
    // ⚠ READ IS isMemberAccount(), NOT `request.auth != null`, BECAUSE THE
    // FIRESTORE RULE ON `resources` SAYS isMember() AND THE BYTES MUST NOT
    // ANSWER A LOOSER QUESTION THAN THE RECORD POINTING AT THEM.
    //
    // ⚠ AND NOTHING MAY CALL getDownloadURL() ON THIS PATH (ADR-0046). That
    // mints a token which serves the bytes past these rules, to anyone holding
    // it, signed out, forever. The library downloads through an authenticated
    // request instead (resources-store.js `openResource`), which IS checked
    // here on every fetch — the same shape as an Event Attachment.
    //
    // No content-type restriction: Word, PDF, images, and whatever the church
    // needs next. The size cap is the one guard, and it matches
    // ResourcesCore.MAX_FILE_BYTES, which the browser refuses at first.
    match /resources/{resourceId}/{fileName} {
      allow read: if isMemberAccount();
      allow write: if editsWithAccount('resources.edit')
        && request.resource.size < 25 * 1024 * 1024;

      // Unlike every other path in this file, a client MAY delete here, and
      // the difference is that this one knows whose bytes these are. A
      // Directory Photo's rule cannot tell an uploader from a stranger, and an
      // Event Attachment is tidied by a trigger. A resource blob lives under
      // the id of the record that owns it, and the only person allowed to
      // delete it is the person already allowed to delete that record.
      //
      // The page deletes the record FIRST. A failure after that leaves bytes
      // nothing points at — inert, unreachable through any screen — rather
      // than a row whose file has gone.
      allow delete: if editsWithAccount('resources.edit');
    }

    // Hymn sheet scans (MS-769). Firestore `hymns` is world-readable; the img
    // tags on the page usually carry a getDownloadURL() token (ADR-0046), but
    // direct Storage reads still answer the same question as the record.
    match /hymn-sheets/{hymnFolder}/{fileName} {
      allow read: if true;
      allow write: if editsWithAccount('hymns.edit')
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if editsWithAccount('hymns.edit');
    }

    // Guide Asset Library bytes (guide-store.js). Firestore `guide_assets` is
    // world-readable and pages embed the getDownloadURL() token in HTML.
    match /guide-assets/{assetId}/{fileName} {
      allow read: if true;
      allow write: if editsWithAccount('services.builder.edit')
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if editsWithAccount('services.builder.edit');
    }
  }
}
