rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Directory photos (ADR-0029). Storage rules cannot read Firestore, so they
    // cannot tell whether this uploader owns this personId — that check lives in
    // the Firestore rule on `people`, which is what decides whether an uploaded
    // image can ever be ATTACHED to a Person. Bytes nobody can attach are inert.
    //
    // What IS enforceable here is the shape of the upload, and that is worth
    // enforcing: without it this path accepts an executable, or a 2GB file, from
    // any signed-in account.
    match /people_photos/{personId}/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // No client deletes. These rules cannot tell whose photo this is, so
      // allowing delete here would let any signed-in account wipe anyone's.
      // The cleanUpReplacedPhoto trigger removes a replaced blob instead —
      // which also catches the browser that closes mid-upload.
      allow delete: if false;
    }

    // ── Who is asking, in Firestore's terms ──────────────────────────────────
    //
    // Cross-service Rules: a Storage rule may read Cloud Firestore. The budget
    // is TWO documents per evaluation and no more, so everything below is
    // arranged to spend exactly two — the asker's `users` document and the
    // occurrence — and never the same one twice.
    //
    // These restate `permissionLevel()`, `isSignedIn()` and `rankCanSee()` from
    // firestore.rules in a second engine that cannot import them. That
    // duplication is real and it is the price of the boundary being enforced
    // where the bytes are; test/storage-event-attachment-rules.test.js reads
    // both files and fails when they drift apart.

    function myUserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // `permissionLevel` with the legacy `role` fallback, exactly as
    // firestore.rules reads it during the MS-119 migration.
    function levelOf(u) {
      return ('permissionLevel' in u) ? u.permissionLevel : u.role;
    }

    // ⚠ Anonymous sign-in is enabled on this project, so `request.auth != null`
    // is NOT "signed in" — same trap firestore.rules documents at length.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ── What the occurrence says about itself ────────────────────────────────
    //
    // An occurrence with no `visibility` field reads as 'none' and matches
    // nothing, so a document that ships unstamped is invisible rather than
    // public — the same fail-closed default firestore.rules takes. A missing
    // occurrence fails the same way: `.data` on nothing denies.

    function stampedVisibility(occ) {
      return ('visibility' in occ) ? occ.visibility : 'none';
    }

    // rankCanSee(), plus the one rung rank alone cannot answer: `participant`
    // is decided against the occurrence's own list of Person ids.
    function rankOrParticipantSees(occ, u) {
      return (stampedVisibility(occ) == 'member'
              && levelOf(u) in ['member', 'editor', 'admin', 'elder', 'super_admin'])
        || (stampedVisibility(occ) in ['member', 'participant', 'editor']
              && levelOf(u) in ['editor', 'admin', 'elder', 'super_admin'])
        || (stampedVisibility(occ) == 'elder'
              && levelOf(u) in ['elder', 'super_admin'])
        || (stampedVisibility(occ) == 'participant'
              && ('personId' in u) && ('participantIds' in occ)
              && u.personId in occ.participantIds);
    }

    // A public occurrence is answered without reading the asker at all, so a
    // signed-out request never reaches a get() on `users/`.
    function canSeeOccurrence(occurrenceId) {
      return canSee(
        firestore.get(/databases/(default)/documents/event_occurrences/$(occurrenceId)).data
      );
    }

    function canSee(occ) {
      return stampedVisibility(occ) == 'public'
        || (isSignedIn() && rankOrParticipantSees(occ, myUserDoc()));
    }

    function isEditorAccount() {
      return isSignedIn()
        && levelOf(myUserDoc()) in ['editor', 'admin', 'elder', 'super_admin'];
    }

    // Event Attachments (MS-287): a file attached to one Event occurrence — a
    // flyer, a sign-up sheet, a floor plan, whatever file type the church
    // needs.
    //
    // READ IS THE OCCURRENCE'S OWN VISIBILITY, not "signed in". Unlike a
    // Directory Photo, an Event has a restrictive rung to under-deliver on:
    // the elders' meeting is elder-only, and its floor plan being a plain file
    // any signed-in account could fetch by path made the rung a decoration.
    // The rule now reads the occurrence's stamped visibility out of Firestore
    // and answers the same question the Firestore rule on
    // `event_occurrences/{id}/attachments` answers about the record pointing
    // here. Whoever may see the Event may see what is attached to it, and
    // nobody else — one sentence, now true in both places.
    //
    // ⚠ THIS RULE IS ONLY HALF THE BOUNDARY. `getDownloadURL()` mints a token
    // that bypasses these rules entirely and never expires, so nothing may
    // ever call it on this path — a single forwarded link would undo
    // everything above, permanently, for a signed-out stranger. Two things
    // keep that shut: the browser downloads through an authenticated request
    // (calendar-event.js `openAttachment`), which IS checked here on every
    // fetch; and `sealEventAttachment` strips the token Storage mints at
    // upload, so there is none left to hand out. See ADR-0046.
    //
    // No content-type restriction, deliberately — "any file type" is the
    // whole point (confirmed on the ticket: not a Google Drive integration,
    // just accepting lots of file types into our own Storage). The size cap
    // matches `EventAttachmentsCore.MAX_ATTACHMENT_BYTES`, which the browser
    // refuses at before the upload even starts.
    match /event_attachments/{occurrenceId}/{attachmentId}/{fileName} {
      allow read: if canSeeOccurrence(occurrenceId);

      // Only an editor uploads, which these rules CAN now answer. Before
      // cross-service reads this said "signed in", and a member could park
      // 25MB under any occurrence id they could guess.
      allow write: if isEditorAccount()
        && request.resource.size < 25 * 1024 * 1024;

      // No client deletes — same reasoning as Directory Photos. Deleting the
      // bytes is the one thing an editor should not do directly: the record
      // is the truth, and `cleanUpDeletedAttachment` removes the blob once the
      // Firestore record pointing at it is gone.
      allow delete: if false;
    }

    // What somebody sent with a form answer (MS-389).
    //
    // ⚠ WRITE IS FALSE, FOR EVERYBODY, AND THAT IS THE DESIGN RATHER THAN AN
    // OVERSIGHT.
    //
    // Somebody answering a public form has no account, and every rule in this
    // file — down to the catch-all below — requires one. There is no rule that
    // could let them upload without opening the bucket to the world. So the
    // bytes go through the same closed door as every other public write: the
    // `publicForm` Cloud Function, which runs past these rules with admin
    // credentials (ADR-0051).
    //
    // That leaves nothing for a client to do here, and `if false` says so
    // better than any condition could: it needs no reasoning about who is
    // asking, and it cannot be loosened by accident.
    //
    // ⚠ AND NOTHING MAY EVER CALL getDownloadURL() ON THIS PATH. It mints a
    // token that bypasses everything above and never expires, so one forwarded
    // link would undo this permanently (ADR-0046). The upload is written with
    // an empty token and the Responses tab fetches it as the signed-in reader,
    // which IS checked here on every request.
    //
    // Read is editor-and-above, restating `isEditor()` from firestore.rules in
    // an engine that cannot import it — the same duplication event_attachments
    // already accepts, and test/storage-form-upload-rules.test.js fails when
    // the two drift.
    match /form_uploads/{formId}/{responseId}/{fileName} {
      allow read: if isEditorAccount();
      allow write: if false;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
