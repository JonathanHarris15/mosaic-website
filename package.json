{
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "firebase-admin": "^13.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "firebase-tools": "^15.23.0",
    "jsdoc": "^4.0.2",
    "preact-render-to-string": "^6.7.0",
    "tailwindcss": "^3.4.19"
  },
  "scripts": {
    "test": "node --test",
    "test:emulator": "node scripts/test-emulator.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i build/tailwind-input.css -o public/mosaic.css --minify",
    "build:tokens": "node scripts/build-design-tokens.mjs",
    "check:design-drift": "node scripts/check-design-drift.mjs",
    "watch:css": "tailwindcss -c tailwind.config.js -i build/tailwind-input.css -o public/mosaic.css --watch",
    "vendor": "node scripts/vendor-assets.mjs && node scripts/vendor-fonts.mjs",
    "vendor:tiptap": "cd build/tiptap && npm install --no-audit --no-fund && npm run build",
    "sync": "npm run build:css && cap sync",
    "mobile:build": "node scripts/mobile-build.mjs"
  }
}
